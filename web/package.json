{
  "name": "web",
  "private": true,
  "type": "module",
  "description": "Shared frontend for backend A and B (served from the same origin as the API, ADR-001)",
  "scripts": {
    "types": "pnpm -F contract exec openapi-typescript ../api/openapi.yaml -o ../web/src/schema.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "lint": "biome ci src",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
