#!/bin/sh
# Block a push that adds a secret. Scans only the commits being pushed, with gitleaks.
# Findings already listed in .gitleaks-baseline.json (old history, accepted 2026-11-18) are skipped.
# Same file in TAWAN-OS-AGENT and pilot-shortlink (TAWAN-OS checklist-gaps T5).

gl=$(command -v gitleaks 2>/dev/null)
if [ -z "$gl" ] && [ -n "$LOCALAPPDATA" ]; then
  links="$(cygpath -u "$LOCALAPPDATA" 2>/dev/null || echo "$LOCALAPPDATA")/Microsoft/WinGet/Links/gitleaks.exe"
  [ -f "$links" ] && gl="$links"
fi
if [ -z "$gl" ]; then
  echo "pre-push: gitleaks not found, push blocked."
  echo "  Install: winget install Gitleaks.Gitleaks   (then open a new terminal)"
  exit 1
fi

root=$(git rev-parse --show-toplevel)
baseline=""
[ -f "$root/.gitleaks-baseline.json" ] && baseline="--baseline-path=$root/.gitleaks-baseline.json"

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch delete, nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # new branch: commits no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  "$gl" git --redact --no-banner $baseline --log-opts="$range" "$root" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: gitleaks found a secret in the commits above, push blocked."
  echo "  Remove it from the commits (rewrite them), rotate the secret, then push again."
fi
exit $status
