{
  "primitive": {
    "color": {
      "neutral": {
        "0": {
          "$value": "#fafeff",
          "$type": "color"
        },
        "50": {
          "$value": "#f2f5f9",
          "$type": "color"
        },
        "100": {
          "$value": "#e8ebef",
          "$type": "color"
        },
        "200": {
          "$value": "#d5d8db",
          "$type": "color"
        },
        "400": {
          "$value": "#83868a",
          "$type": "color"
        },
        "500": {
          "$value": "#565b61",
          "$type": "color"
        },
        "600": {
          "$value": "#43484e",
          "$type": "color"
        },
        "700": {
          "$value": "#2e3339",
          "$type": "color"
        },
        "800": {
          "$value": "#1b2025",
          "$type": "color"
        },
        "850": {
          "$value": "#13181d",
          "$type": "color"
        },
        "900": {
          "$value": "#0b1015",
          "$type": "color"
        },
        "950": {
          "$value": "#05080c",
          "$type": "color"
        }
      },
      "green": {
        "300": {
          "$value": "#7ad59c",
          "$type": "color"
        },
        "400": {
          "$value": "#4ebe7d",
          "$type": "color"
        },
        "600": {
          "$value": "#00793d",
          "$type": "color"
        },
        "700": {
          "$value": "#005f2e",
          "$type": "color"
        }
      },
      "red": {
        "400": {
          "$value": "#f47b74",
          "$type": "color"
        },
        "600": {
          "$value": "#be222a",
          "$type": "color"
        }
      }
    }
  },
  "color": {
    "surface": {
      "$value": "{primitive.color.neutral.50}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.900}"
        }
      }
    },
    "surface-raised": {
      "$value": "{primitive.color.neutral.0}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.850}"
        }
      }
    },
    "surface-sunken": {
      "$value": "{primitive.color.neutral.100}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.950}"
        }
      }
    },
    "border": {
      "$value": "{primitive.color.neutral.200}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.700}"
        }
      }
    },
    "border-strong": {
      "$value": "{primitive.color.neutral.400}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.400}"
        }
      }
    },
    "text": {
      "$value": "{primitive.color.neutral.800}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.100}"
        }
      }
    },
    "text-muted": {
      "$value": "{primitive.color.neutral.500}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.400}"
        }
      }
    },
    "accent": {
      "$value": "{primitive.color.green.600}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.green.400}"
        }
      }
    },
    "accent-hover": {
      "$value": "{primitive.color.green.700}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.green.300}"
        }
      }
    },
    "on-accent": {
      "$value": "{primitive.color.neutral.0}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.neutral.950}"
        }
      }
    },
    "danger": {
      "$value": "{primitive.color.red.600}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.red.400}"
        }
      }
    },
    "focus": {
      "$value": "{primitive.color.green.600}",
      "$type": "color",
      "$extensions": {
        "mode": {
          "dark": "{primitive.color.green.300}"
        }
      }
    }
  },
  "font": {
    "family": {
      "ui": {
        "$value": "'IBM Plex Sans Thai', 'IBM Plex Sans', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'IBM Plex Mono', ui-monospace, monospace",
        "$type": "fontFamily"
      }
    },
    "size": {
      "sm": {
        "$value": "0.875rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "lg": {
        "$value": "1.125rem",
        "$type": "dimension"
      },
      "xl": {
        "$value": "1.5rem",
        "$type": "dimension"
      }
    },
    "line-height": {
      "body": {
        "$value": "1.6",
        "$type": "number"
      },
      "tight": {
        "$value": "1.3",
        "$type": "number"
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$type": "fontWeight"
      },
      "medium": {
        "$value": "500",
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": "600",
        "$type": "fontWeight"
      }
    }
  },
  "space": {
    "1": {
      "$value": "4px",
      "$type": "dimension"
    },
    "2": {
      "$value": "8px",
      "$type": "dimension"
    },
    "3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "4": {
      "$value": "16px",
      "$type": "dimension"
    },
    "6": {
      "$value": "24px",
      "$type": "dimension"
    },
    "8": {
      "$value": "32px",
      "$type": "dimension"
    },
    "12": {
      "$value": "48px",
      "$type": "dimension"
    }
  },
  "radius": {
    "sm": {
      "$value": "4px",
      "$type": "dimension"
    },
    "md": {
      "$value": "6px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "10px",
      "$type": "dimension"
    }
  },
  "size": {
    "row": {
      "$value": "48px",
      "$type": "dimension"
    },
    "control": {
      "$value": "40px",
      "$type": "dimension"
    },
    "content-max": {
      "$value": "1040px",
      "$type": "dimension"
    }
  },
  "focus": {
    "ring-width": {
      "$value": "2px",
      "$type": "dimension"
    },
    "ring-offset": {
      "$value": "2px",
      "$type": "dimension"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "150ms",
        "$type": "duration"
      }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)",
        "$type": "cubicBezier"
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": {
          "$value": "{color.accent}",
          "$type": "color"
        },
        "bg-hover": {
          "$value": "{color.accent-hover}",
          "$type": "color"
        },
        "fg": {
          "$value": "{color.on-accent}",
          "$type": "color"
        }
      },
      "radius": {
        "$value": "{radius.md}",
        "$type": "dimension"
      },
      "height": {
        "$value": "{size.control}",
        "$type": "dimension"
      }
    },
    "input": {
      "border": {
        "$value": "{color.border-strong}",
        "$type": "color"
      },
      "radius": {
        "$value": "{radius.md}",
        "$type": "dimension"
      },
      "height": {
        "$value": "{size.control}",
        "$type": "dimension"
      }
    },
    "table": {
      "row-height": {
        "$value": "{size.row}",
        "$type": "dimension"
      },
      "row-border": {
        "$value": "{color.border}",
        "$type": "color"
      }
    },
    "sparkline": {
      "stroke": {
        "$value": "{color.accent}",
        "$type": "color"
      }
    }
  }
}
